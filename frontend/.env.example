# =============================================================================
# Budget App — frontend environment template
# =============================================================================
# Copy to `frontend/.env`:
#     cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. Never
# put secrets here: anything in this file is public.
# =============================================================================

# Base URL of the Django API, without a trailing slash.
#   local development ......... http://127.0.0.1:8000
#   deployed backend .......... https://budget-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000
