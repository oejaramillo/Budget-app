# =============================================================================
# Budget App — backend environment template
# =============================================================================
# Copy to `backend/.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored on purpose. Never commit real credentials.
# =============================================================================

# --- Django core -------------------------------------------------------------
# Required. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret

# `development` (default) or `production`.
DJANGO_ENV=development

# Comma separated hostnames, no scheme. Wildcards are allowed in development
# only; production refuses to boot with "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Option A (recommended): a single Neon connection string. Copy it from
# Neon Console -> Project -> Dashboard -> Connection string, and keep the
# `?sslmode=require` part.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Option B: discrete variables (used when DATABASE_URL is empty).
# Point these at the Neon host to avoid repeating the full URL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Keep connections open between requests. Use 0 with the Neon *pooler* endpoint
# when running many short-lived connections (for example serverless).
DB_CONN_MAX_AGE=0

# --- Frontend origins allowed to call this API --------------------------------
# Comma separated, with scheme. In development the Vite dev server is enough;
# CORS_ALLOW_ALL_ORIGINS=true is implied by DJANGO_ENV=development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Auth token lifetimes ----------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Exchange rates ----------------------------------------------------------
# Free key from https://www.exchangerate-api.com/ — optional, the app runs
# without it and you can create currencies manually from the admin.
EXCHANGE_API_KEY=change-me
EXCHANGE_API_BASE_URL=https://v6.exchangerate-api.com/v6
